# OwnCA demo — copy to `.env` and edit. docker compose picks it up automatically.
# Every variable here is optional; the defaults below are what the stack uses
# when the file is absent.

# Admin account created on first start (change it before showing this to anyone).
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=admin

# Long title shown in the topbar.
OWNCA_PROJECT_TITLE=Own Certificate Authority

# Certified GOST backend. Only has an effect if CryptoPro CSP was baked into the
# dashboard image at build time (see build-images.sh / OWNCA_CRYPTOPRO_DIST).
OWNCA_CRYPTOPRO_ENABLED=False
# Licence serial; empty means the built-in 90-day demo licence.
OWNCA_CRYPTOPRO_LICENSE=
